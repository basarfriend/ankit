<%- include('../partials/header') %>
<section class="auth-layout login-layout">
  <div class="auth-intro"><span class="eyebrow">WELCOME BACK</span><h1>Let’s get things moving.</h1><p>Sign in to check your tickets, reply to your support team, or pick up where you left off.</p><div class="intro-points"><span>✓ Clear updates, all in one place</span><span>✓ A team ready to help</span></div></div>
  <div class="panel auth-panel">
    <div class="panel-heading"><h2>Log in to Tixly</h2><p>Enter your account details to continue.</p></div>
    <form action="/login" method="post" class="stack-form">
      <label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username" required value="<%= formValues.email || '' %>" aria-describedby="email-error"><% if (formErrors.email) { %><small class="field-error" id="email-error"><%= formErrors.email %></small><% } %>
      <label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required aria-describedby="password-error"><% if (formErrors.password) { %><small class="field-error" id="password-error"><%= formErrors.password %></small><% } %>
      <button class="button button-primary button-wide" type="submit">Log in</button>
    </form>
    <p class="auth-switch">New to Tixly? <a href="/register">Create an account</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
