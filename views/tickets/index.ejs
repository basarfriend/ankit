<%- include('../partials/header') %>
<section class="page-heading heading-row"><div><span class="eyebrow">SUPPORT WORKSPACE</span><h1>Tickets</h1><p><%= total %> <%= total === 1 ? 'request' : 'requests' %> found</p></div><a class="button button-primary" href="/tickets/new">＋ New ticket</a></section>
<form class="panel filters" action="/tickets" method="get">
  <div class="filter-search"><label for="search">Search tickets</label><input id="search" name="search" type="search" placeholder="Title, description or #number" value="<%= filters.search || '' %>"></div>
  <div><label for="status">Status</label><select id="status" name="status"><option value="">Any status</option><% ['Open','In Progress','Resolved','Closed'].forEach((value) => { %><option <%= filters.status === value ? 'selected' : '' %>><%= value %></option><% }); %></select></div>
  <div><label for="priority">Priority</label><select id="priority" name="priority"><option value="">Any priority</option><% ['Low','Medium','High','Urgent'].forEach((value) => { %><option <%= filters.priority === value ? 'selected' : '' %>><%= value %></option><% }); %></select></div>
  <div><label for="category">Category</label><select id="category" name="category"><option value="">Any category</option><% ['Bug','Access','Billing','Booking','General'].forEach((value) => { %><option <%= filters.category === value ? 'selected' : '' %>><%= value %></option><% }); %></select></div>
  <div class="filter-actions"><button class="button button-primary button-small" type="submit">Apply filters</button><a class="button button-quiet button-small" href="/tickets">Clear</a></div>
</form>
<section class="panel table-panel">
  <% if (tickets.length) { %>
    <div class="ticket-list">
      <% tickets.forEach((ticket) => { %><a class="ticket-row" href="/tickets/<%= ticket.id %>"><span class="ticket-icon">↗</span><span class="ticket-summary"><strong><span class="ticket-number">#<%= ticket.ticketNumber %></span> <%= ticket.title %></strong><small><%= ticket.category %> · Updated <%= new Date(ticket.updatedAt).toLocaleDateString() %><% if (['Agent','Admin'].includes(currentUser.role)) { %> · <%= ticket.createdBy.name %><% } %></small></span><span class="ticket-side"><span class="badge badge-<%= ticket.status.toLowerCase().replace(' ', '-') %>"><%= ticket.status %></span><span class="priority priority-<%= ticket.priority.toLowerCase() %>"><%= ticket.priority %></span></span></a><% }); %>
    </div>
    <% if (pages > 1) { %><nav class="pagination" aria-label="Pagination"><% if (page > 1) { %><a class="button button-quiet button-small" href="?<%= new URLSearchParams({...filters, page: page - 1}).toString() %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a class="button button-quiet button-small" href="?<%= new URLSearchParams({...filters, page: page + 1}).toString() %>">Next →</a><% } %></nav><% } %>
  <% } else { %><div class="empty-state"><span class="empty-icon">⌕</span><h3>No matching tickets</h3><p>Try adjusting the filters, or create a new support request.</p><a class="button button-secondary" href="/tickets/new">Create a ticket</a></div><% } %>
</section>
<%- include('../partials/footer') %>
