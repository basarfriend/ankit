<form action="<%= action %>" method="post" class="panel form-panel stack-form">
  <% if (method) { %><input type="hidden" name="_method" value="<%= method %>"><% } %>
  <label for="title">Title</label><input id="title" name="title" type="text" minlength="4" maxlength="120" required value="<%= formValues.title !== undefined ? formValues.title : ticket ? ticket.title : '' %>" aria-describedby="title-error"><% if (formErrors.title) { %><small class="field-error" id="title-error"><%= formErrors.title %></small><% } %>
  <label for="description">Description</label><textarea id="description" name="description" minlength="10" maxlength="5000" rows="7" required aria-describedby="description-error"><%= formValues.description !== undefined ? formValues.description : ticket ? ticket.description : '' %></textarea><span class="help-text">Include any details that will help us resolve your request.</span><% if (formErrors.description) { %><small class="field-error" id="description-error"><%= formErrors.description %></small><% } %>
  <div class="form-grid">
    <div><label for="category">Category</label><select id="category" name="category" required><% ['Bug','Access','Billing','Booking','General'].forEach((value) => { %><option value="<%= value %>" <%= (formValues.category || (ticket && ticket.category) || 'General') === value ? 'selected' : '' %>><%= value %></option><% }); %></select><% if (formErrors.category) { %><small class="field-error"><%= formErrors.category %></small><% } %></div>
    <div><label for="priority">Priority</label><select id="priority" name="priority" required><% ['Low','Medium','High','Urgent'].forEach((value) => { %><option value="<%= value %>" <%= (formValues.priority || (ticket && ticket.priority) || 'Medium') === value ? 'selected' : '' %>><%= value %></option><% }); %></select><% if (formErrors.priority) { %><small class="field-error"><%= formErrors.priority %></small><% } %></div>
  </div>
  <div class="form-actions"><a class="button button-quiet" href="<%= ticket ? `/tickets/${ticket.id}` : '/tickets' %>">Cancel</a><button class="button button-primary" type="submit"><%= ticket ? 'Save changes' : 'Submit ticket' %></button></div>
</form>
