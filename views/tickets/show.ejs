<%- include('../partials/header') %>
<section class="page-heading detail-heading">
  <a class="back-link" href="/tickets">← All tickets</a>
  <div class="detail-title-row"><div><span class="eyebrow">TICKET #<%= ticket.ticketNumber %></span><h1><%= ticket.title %></h1></div><span class="badge badge-<%= ticket.status.toLowerCase().replace(' ', '-') %> badge-large"><%= ticket.status %></span></div>
  <p>Created <%= new Date(ticket.createdAt).toLocaleString() %> by <%= ticket.createdBy.name %></p>
</section>
<div class="detail-layout">
  <div class="detail-main">
    <section class="panel detail-card"><div class="section-heading"><div><h2>Request details</h2><p>Ticket #<%= ticket.ticketNumber %></p></div><span class="priority priority-<%= ticket.priority.toLowerCase() %>"><%= ticket.priority %> priority</span></div>
      <p class="description-text"><%= ticket.description %></p>
      <div class="detail-tags"><span class="meta-tag"><span class="meta-label">Category</span><%= ticket.category %></span><span class="meta-tag"><span class="meta-label">Created</span><%= new Date(ticket.createdAt).toLocaleDateString() %></span><span class="meta-tag"><span class="meta-label">Updated</span><%= new Date(ticket.updatedAt).toLocaleDateString() %></span></div>
      <% if (currentUser.role === 'User' && ticket.status === 'Open' && String(ticket.createdBy._id) === currentUser.id) { %><div class="form-actions ticket-owner-actions"><a class="button button-secondary button-small" href="/tickets/<%= ticket.id %>/edit">Edit ticket</a><form action="/tickets/<%= ticket.id %>?_method=DELETE" method="post" data-confirm="Delete this ticket? This cannot be undone."><button class="button button-danger button-small" type="submit">Delete ticket</button></form></div><% } %>
    </section>
    <% if (['Agent','Admin'].includes(currentUser.role)) { %>
      <section class="panel action-panel"><div class="section-heading"><div><h2>Team actions</h2><p>Keep this request moving.</p></div></div><div class="team-actions">
        <form action="/tickets/<%= ticket.id %>/status?_method=PATCH" method="post" class="inline-form"><label for="new-status">Update status</label><div class="inline-controls"><select id="new-status" name="status" required><% const nextStatuses = ticket.status === 'Open' ? ['In Progress'] : ticket.status === 'In Progress' ? ['Resolved'] : ticket.status === 'Resolved' ? ['Closed','In Progress'] : []; nextStatuses.forEach((status) => { %><option value="<%= status %>"><%= status %></option><% }); %></select><button class="button button-primary button-small" type="submit" <%= nextStatuses.length ? '' : 'disabled' %>>Update</button></div></form>
        <form action="/tickets/<%= ticket.id %>/assign?_method=PATCH" method="post" class="inline-form"><label for="assignedTo">Assign to</label><div class="inline-controls"><select id="assignedTo" name="assignedTo" required><option value="">Choose a team member</option><% agents.forEach((agent) => { %><option value="<%= agent.id %>" <%= ticket.assignedTo && String(ticket.assignedTo._id) === agent.id ? 'selected' : '' %>><%= agent.name %> · <%= agent.role %></option><% }); %></select><button class="button button-secondary button-small" type="submit">Assign</button></div></form>
      </div></section>
    <% } else if (ticket.status === 'Resolved') { %>
      <section class="panel action-panel"><h2>Is this resolved?</h2><p>You can close this ticket or reopen it if you still need help.</p><div class="form-actions"><form action="/tickets/<%= ticket.id %>/status?_method=PATCH" method="post"><input type="hidden" name="status" value="Open"><button class="button button-secondary button-small" type="submit">Reopen ticket</button></form><form action="/tickets/<%= ticket.id %>/status?_method=PATCH" method="post"><input type="hidden" name="status" value="Closed"><button class="button button-primary button-small" type="submit">Close ticket</button></form></div></section>
    <% } %>
    <section class="panel comments-panel" id="comments"><div class="section-heading"><div><h2>Conversation</h2><p><%= comments.length %> <%= comments.length === 1 ? 'reply' : 'replies' %></p></div></div>
      <% if (comments.length) { %><div class="comment-list"><% comments.forEach((comment) => { %><article class="comment"><span class="avatar"><%= comment.author.name.charAt(0).toUpperCase() %></span><div class="comment-body"><div class="comment-heading"><strong><%= comment.author.name %></strong><span class="role-label"><%= comment.author.role %></span><time><%= new Date(comment.createdAt).toLocaleString() %></time></div><p><%= comment.message %></p></div></article><% }); %></div><% } else { %><p class="muted-text">No replies yet. Start the conversation below.</p><% } %>
      <% if (ticket.status !== 'Closed') { %><form action="/tickets/<%= ticket.id %>/comments" method="post" class="reply-form"><label for="message">Add a reply</label><textarea id="message" name="message" rows="4" minlength="2" maxlength="3000" required placeholder="Write a reply…"><%= formValues.message || '' %></textarea><% if (formErrors.message) { %><small class="field-error"><%= formErrors.message %></small><% } %><div class="form-actions"><span class="help-text">Your reply is visible to everyone on this ticket.</span><button class="button button-primary button-small" type="submit">Send reply</button></div></form><% } else { %><p class="muted-text closed-note">This ticket is closed. Replies are disabled.</p><% } %>
    </section>
  </div>
  <aside class="detail-aside">
    <section class="panel timeline-panel"><h2>Status history</h2><ol class="timeline"><% ticket.statusHistory.forEach((entry) => { %><li><span class="timeline-dot"></span><div><strong><%= entry.status %></strong><time><%= new Date(entry.date).toLocaleString() %></time><small><%= entry.changedBy && entry.changedBy.name ? entry.changedBy.name : (String(entry.changedBy) === currentUser.id ? 'You' : 'Team member') %></small></div></li><% }); %></ol></section>
    <section class="panel assigned-panel"><h2>Request owner</h2><div class="person-row"><span class="avatar"><%= ticket.createdBy.name.charAt(0).toUpperCase() %></span><div><strong><%= ticket.createdBy.name %></strong><small>Ticket creator</small></div></div><div class="person-row"><span class="avatar avatar-soft"><%= ticket.assignedTo ? ticket.assignedTo.name.charAt(0).toUpperCase() : '—' %></span><div><strong><%= ticket.assignedTo ? ticket.assignedTo.name : 'Unassigned' %></strong><small>Assigned team member</small></div></div></section>
  </aside>
</div>
<%- include('../partials/footer') %>
